---
interface Props { name: 'arrow' | 'down' | 'close' | 'sun' | 'moon' | 'system' | 'plus' | 'gmail' | 'linkedin' | 'github'; size?: number }
const { name, size = 20 } = Astro.props;
const brands = { gmail: '/brands/gmail.svg', linkedin: '/brands/linkedin.png', github: '/brands/github.svg' };
const brand = name in brands ? brands[name as keyof typeof brands] : null;
const paths = {
  arrow: ['M5 12h14', 'm13 6 6 6-6 6'],
  down: ['M12 4v16', 'm6 14 6 6 6-6'],
  close: ['m6 6 12 12', 'M18 6 6 18'],
  sun: ['M12 3V1m0 22v-2M3 12H1m22 0h-2M5.6 5.6 4.2 4.2m15.6 15.6-1.4-1.4M5.6 18.4l-1.4 1.4M19.8 4.2l-1.4 1.4', 'M16.5 12a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0'],
  moon: ['M20.5 13a8.5 8.5 0 1 1-9.5-9.5A7 7 0 0 0 20.5 13Z'],
  system: ['M4 4h16v12H4z', 'M12 16v4m-4 0h8'],
  plus: ['M12 5v14', 'M5 12h14'],
};
---
{brand ? <img class="brand-icon" src={brand} width={size} height={size} alt="" aria-hidden="true" loading="lazy" /> : <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {paths[name as keyof typeof paths].map(d => <path d={d} />)}
</svg>}
