---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProjectArt from '../../components/ProjectArt.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import { projects, categories } from '../../data/projects';
---
<Base route="work" title="All work · Vignesh Mayandia Chandran" description="Seven projects by Vignesh Mayandia Chandran: market-entry and growth strategy, inspection systems at Dow, applied AI, analytics and student leadership.">
  <section class="container work-collection" id="stories" aria-labelledby="work-title" data-work-browser>
    <header class="work-heading"><h1 id="work-title">All work</h1><p>Seven projects in business strategy, industrial operations, applied AI, analytics and student leadership.</p></header>
    <div class="collection-toolbar"><div class="work-filters" role="group" aria-label="Filter projects by focus" data-work-filters hidden>{categories.map(category => <button type="button" data-filter={category.value} aria-pressed={category.value === 'all' ? 'true' : 'false'}>{category.label}<span aria-hidden="true">{String(category.count).padStart(2, '0')}</span></button>)}</div><p class="result-count" role="status" aria-live="polite" data-result-count>7 projects</p></div>
    <ul class="project-grid">
      {projects.map(project => <li class:list={['project-card', project.slug === 'dow' && 'project-featured']} data-project={project.slug} data-category={project.category}>
        <div class="project-visual"><div class="poster-topline"><p>{project.context}</p></div><ProjectArt project={project} /></div>
        <div class="project-copy"><p class="project-category">{project.capability}</p><h2><a href={project.href}>{project.title}</a></h2><p class="project-summary">{project.summary}</p><p class="project-detail">{project.detail}</p><p class="project-status">{project.status}</p><div class="project-actions"><a class="card-story-link" href={project.href}>{project.linkText} <Icon name="arrow" size={18} /></a><button type="button" class="quick-look" data-preview={project.slug} aria-label={`Quick look: ${project.context}`} aria-haspopup="dialog" hidden><Icon name="plus" size={17} /><span>Quick look</span></button></div></div>
      </li>)}
    </ul>
    {projects.map(project => <ProjectPreview project={project} />)}
  </section>
  <dialog class="project-preview" data-project-dialog aria-modal="true"><button class="preview-close" type="button" aria-label="Close preview" data-close-preview autofocus><Icon name="close" size={21} /></button><div data-preview-content></div></dialog>
</Base>
